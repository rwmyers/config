#!/usr/bin/env bash
# Wi-Fi menu for Hyprland/Wayland. Uses nmcli (NetworkManager) + walker in dmenu
# mode — no Python/PyGObject and no external clone. Wired to the Waybar network
# module's on-click; bind it in Hyprland too if you like.
set -uo pipefail

MENU() { walker --dmenu "$@"; }
notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Wi-Fi" "$@"; }

iface=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}')
if [ -z "$iface" ]; then
    notify "No Wi-Fi device found"
    exit 1
fi

# Radio off → the only useful action is turning it back on.
if [ "$(nmcli -t radio wifi)" != "enabled" ]; then
    if printf '%s\n' "󰖩  Enable Wi-Fi" | MENU >/dev/null; then
        nmcli radio wifi on && notify "Wi-Fi enabled"
    fi
    exit 0
fi

# Build parallel arrays; walker --index returns the chosen row number, so we map
# the selection back to the real SSID without parsing the decorated label.
labels=(); ssids=(); secs=(); kinds=(); declare -A seen
add() { labels+=("$1"); ssids+=("$2"); secs+=("$3"); kinds+=("$4"); }

while IFS= read -r line; do
    # IN-USE:BARS:SECURITY:SSID — only SSID can contain ':' (escaped by nmcli as
    # '\:'), and it's last, so peel the fixed fields off the front.
    inuse=${line%%:*}; rest=${line#*:}
    bars=${rest%%:*};  rest=${rest#*:}
    sec=${rest%%:*};   ssid=${rest#*:}
    ssid=${ssid//\\:/:}
    [ -z "$ssid" ] && continue
    lock="";   { [ -n "$sec" ] && [ "$sec" != "--" ]; } && lock="  "
    # Collapse the multiple APs a single SSID advertises into one row; if any of
    # them is the active connection, keep the connected marker.
    if [ -n "${seen[$ssid]+x}" ]; then
        [ "$inuse" = "*" ] && labels[${seen[$ssid]}]="● ${bars}  ${ssid}${lock}"
        continue
    fi
    mark="  "; [ "$inuse" = "*" ] && mark="● "
    seen[$ssid]=${#labels[@]}
    add "${mark}${bars}  ${ssid}${lock}" "$ssid" "$sec" "net"
done < <(nmcli --terse --fields IN-USE,BARS,SECURITY,SSID device wifi list --rescan yes)

add "󰑓  Rescan networks" "" "" "rescan"
add "󰖪  Disable Wi-Fi"   "" "" "disable"
active=$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v d="$iface" '$2==d{print $1; exit}')
[ -n "$active" ] && add "󰅖  Disconnect ($active)" "$active" "" "disconnect"

idx=$(printf '%s\n' "${labels[@]}" | MENU --index) || exit 0
[[ "$idx" =~ ^[0-9]+$ ]] || exit 0

kind=${kinds[$idx]}; ssid=${ssids[$idx]}; sec=${secs[$idx]}
case "$kind" in
    rescan)     exec "$0" ;;
    disable)    nmcli radio wifi off && notify "Wi-Fi disabled"; exit 0 ;;
    disconnect) nmcli connection down id "$ssid" && notify "Disconnected from $ssid"; exit 0 ;;
esac

# A saved profile just needs bringing up; a new network may need a passphrase.
if nmcli -t -f NAME connection show | grep -Fxq "$ssid"; then
    if nmcli connection up id "$ssid" >/dev/null 2>&1; then
        notify "Connected to $ssid"
    else
        notify "Failed to activate $ssid"
    fi
    exit 0
fi

if [ -n "$sec" ] && [ "$sec" != "--" ]; then
    pw=$(printf '' | MENU --password) || exit 0
    [ -z "$pw" ] && exit 0
    msg=$(nmcli device wifi connect "$ssid" password "$pw" 2>&1)
else
    msg=$(nmcli device wifi connect "$ssid" 2>&1)
fi

if printf '%s' "$msg" | grep -qi 'successfully activated'; then
    notify "Connected to $ssid"
else
    notify "Could not connect to $ssid" "$msg"
fi
