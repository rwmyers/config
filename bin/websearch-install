#!/bin/bash

# Add a search to the walker/elephant websearch menu (super+s). Entries live in
# ~/.config/elephant/websearch.toml, which is machine-local and untracked, so
# each machine in the fleet keeps its own set.

CONFIG="$HOME/.config/elephant/websearch.toml"
ICON_DIR="$HOME/.config/elephant/icons"

if [ "$#" -lt 2 ]; then
  echo -e "\e[32mLet's add a search to the web search menu (super+s).\n\e[0m"
  NAME=$(gum input --prompt "Name> " --placeholder "My favorite site")
  URL=$(gum input --prompt "URL> " --placeholder "https://example.com/search?q=%TERM% (omit %TERM% to just open the URL)")
  PREFIX=$(gum input --prompt "Prefix> " --placeholder "e.g. 'gh ' to trigger with 'gh query'. Blank = shows in every search")
  ICON_REF=$(gum input --prompt "Icon URL> " --placeholder "Optional, see https://dashboardicons.com (must use PNG!)")
  INTERACTIVE_MODE=true
else
  NAME="$1"
  URL="$2"
  PREFIX="$3"   # Optional trigger prefix
  ICON_REF="$4" # Optional icon URL or filename in the elephant icons dir
  INTERACTIVE_MODE=false
fi

if [[ -z "$NAME" || -z "$URL" ]]; then
  echo "You must set a name and a URL!"
  exit 1
fi

# Values land in double-quoted TOML strings, so reject the characters that
# would break out of them.
if [[ "$NAME$URL$PREFIX" == *'"'* || "$NAME$URL$PREFIX" == *\\* ]]; then
  echo "Name, URL and prefix cannot contain double quotes or backslashes."
  exit 1
fi

# Seed the config if this machine hasn't got one yet. Matches what
# install/env/walker-and-elephant.sh writes on a fresh install.
if [ ! -e "$CONFIG" ]; then
  mkdir -p "$(dirname "$CONFIG")"
  cat >"$CONFIG" <<EOF
command = "webapp-open"

[[entries]]
name = "Google"
default = true
url = "https://www.google.com/search?q=%TERM%"
icon = "$ICON_DIR/google.png"
EOF
fi

if grep -q "^name = \"$NAME\"$" "$CONFIG"; then
  echo "\"$NAME\" is already in the web search menu"
  exit 0
fi

# Refer to local icon or fetch remotely from URL
ICON_PATH=""
if [[ -n $ICON_REF ]]; then
  mkdir -p "$ICON_DIR"
  if [[ $ICON_REF =~ ^https?:// ]]; then
    if curl -sL -o "$ICON_DIR/$NAME.png" "$ICON_REF"; then
      ICON_PATH="$ICON_DIR/$NAME.png"
    else
      echo "Error: Failed to download icon."
      exit 1
    fi
  else
    ICON_PATH="$ICON_DIR/$ICON_REF"
  fi
fi

# Drop trailing blank lines (removals leave them) so blocks stay one apart.
TRIMMED=$(mktemp)
awk 'NF { for (i = 1; i <= blanks; i++) print ""; blanks = 0; print; next } { blanks++ }' "$CONFIG" >"$TRIMMED"
mv "$TRIMMED" "$CONFIG"

{
  echo ""
  echo "[[entries]]"
  echo "name = \"$NAME\""
  echo "url = \"$URL\""
  [[ -n $PREFIX ]] && echo "prefix = \"$PREFIX\""
  [[ -n $ICON_PATH ]] && echo "icon = \"$ICON_PATH\""
} >>"$CONFIG"

# elephant only reads websearch.toml at startup.
if systemctl --user is-enabled elephant.service &>/dev/null; then
  systemctl --user restart elephant.service
fi

if [[ $INTERACTIVE_MODE == true ]]; then
  if [[ -n $PREFIX ]]; then
    echo -e "Search $NAME by typing \"$PREFIX<query>\" (super+s)\n"
  else
    # elephant shows every prefix-less entry for every query, and passes the
    # typed text through untouched, so a prefix is what makes an entry usable.
    echo -e "Added $NAME. Without a prefix it appears in the results for every"
    echo -e "search, and your whole query is sent to it verbatim.\n"
  fi
fi
