#compdef dot
# Dotfiles completions

local -a commands
local context state state_descr line

commands=(
    'root:Execute the root command'
    'update:Updates the setup'
    'upgrade:Upgrade nix packages past the pinned flake.lock'
    'config:Toggle optional installs'
)

_arguments -C \
    '1: :->cmds' \
    '*:: :-> args'

case "$state" in
    cmds)
        _describe -t commands 'commands' commands
        ;;
    args)
        case $line[1] in
            root)
                _message "No arguments for root"
                ;;
            update)
                _message "No arguments for update"
                ;;
            upgrade)
                # Flake input names, read from the top-level inputs block.
                local -a inputs
                inputs=(${(f)"$(sed -n '/^  inputs = {/,/^  };/p' \
                    $HOME/src/config/nix/flake.nix \
                    | grep -oE '^    [A-Za-z0-9_-]+' | tr -d ' ')"})
                _describe -t inputs 'flake input (default: all)' inputs
                ;;
            config)
                _message "No arguments for config"
                ;;
        esac
        ;;
esac
